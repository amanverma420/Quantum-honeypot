# QuantumGuard Enterprise Environment Configuration
# ===================================================

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# Database Connection (Defaults to SQLite for local development; use PostgreSQL for production)
DATABASE_URL=sqlite:///./quantumguard.db
# For PostgreSQL:
# DATABASE_URL=postgresql://quantum_user:your_secure_password@localhost:5432/quantumguard_db

# Security & Cryptographic Tokens
# Generate a strong 32+ character random key for production:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
TOKEN_EXPIRY_SECONDS=86400
POSTGRES_PASSWORD=

# Bootstrap passwords are required only when these accounts are first created.
# Set unique values locally; leave unset in the checked-in template.
INITIAL_ADMIN_PASSWORD=
INITIAL_ANALYST_PASSWORD=

# Decoy Trap Ports & Bindings (Bind to 127.0.0.1 by default for containment)
DECOY_BIND_HOST=127.0.0.1
DECOY_HTTP_PORT=8080
DECOY_SSH_PORT=2222

# Allowed CORS Origins (Comma-separated for production frontend domain)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,https://your-domain.vercel.app
